
.exp253-bay-panel{background:radial-gradient(circle at 15% 20%,rgba(255,87,179,.22),transparent 28%),radial-gradient(circle at 85% 78%,rgba(74,199,255,.2),transparent 28%),var(--panel)}
.exp253-arrival-card{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;margin:2rem 0;padding:1.4rem;border:1px solid rgba(255,151,207,.55);border-radius:24px;background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.02))}
.exp253-arrival-copy h3,.exp253-passport-row h3{font-family:"Playfair Display",serif;font-size:clamp(1.7rem,3vw,2.7rem);margin:.25rem 0}
.exp253-arrival-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1rem}
.exp253-ticket-board{min-width:240px;padding:1.25rem;border:1px dashed #ff9bce;border-radius:18px;text-align:center;background:#170018}
.exp253-ticket-board span{display:block;font-size:2.5rem}.exp253-ticket-board strong,.exp253-ticket-board small{display:block}.exp253-ticket-board small{margin-top:.35rem;color:#ffb7da}
.exp253-district-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
.exp253-district-grid article{overflow:hidden;border:1px solid rgba(255,130,194,.4);border-radius:24px;background:#100012;box-shadow:0 20px 55px rgba(0,0,0,.35)}
.exp253-district-grid img{width:100%;aspect-ratio:4/5;object-fit:cover;display:block}.exp253-district-grid article div{padding:1rem}.exp253-district-grid h3{font-size:1.5rem;margin:.2rem 0}
.exp253-passport-row{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;padding:1.3rem;border:1px solid rgba(255,152,207,.4);border-radius:20px;background:#0b000d}
.exp253-passport-row.is-stamped{box-shadow:0 0 30px rgba(255,83,178,.28);border-color:#ffd66a}
.location-bay{right:2%;bottom:4%}
@media(max-width:760px){.exp253-arrival-card{grid-template-columns:1fr}.exp253-ticket-board{min-width:0}.exp253-district-grid{grid-template-columns:1fr}.exp253-passport-row{align-items:flex-start;flex-direction:column}}


.exp254-bay-world{background:radial-gradient(circle at 18% 10%,rgba(67,202,255,.18),transparent 25%),radial-gradient(circle at 82% 16%,rgba(255,73,173,.2),transparent 24%),var(--panel)}
.exp254-music-bar{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:2rem 0 1rem;padding:1rem 1.2rem;border:1px solid rgba(255,152,207,.45);border-radius:20px;background:#0c000f}
.exp254-music-bar small,.exp254-music-bar strong{display:block}.exp254-song-buttons{display:flex;gap:.55rem;flex-wrap:wrap}.exp254-song-buttons button{padding:.7rem .9rem;border:1px solid rgba(255,139,202,.55);border-radius:999px;background:#ffffff0d;color:#fff;cursor:pointer}
.exp254-zone-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.exp254-zone-card{position:relative;overflow:hidden;min-height:330px;padding:0;border:1px solid rgba(255,145,205,.45);border-radius:24px;background:#100012;color:#fff;text-align:left;cursor:pointer;box-shadow:0 20px 55px rgba(0,0,0,.35);transition:.25s}
.exp254-zone-card:hover{transform:translateY(-6px);box-shadow:0 25px 65px rgba(0,0,0,.42),0 0 30px rgba(255,77,177,.2)}.exp254-zone-card img{display:block;width:100%;height:250px;object-fit:cover}.exp254-zone-card>span,.exp254-zone-card>strong,.exp254-zone-card>small{margin-left:1rem;margin-right:1rem}.exp254-zone-card>span{display:block;margin-top:.8rem;font-size:1.5rem}.exp254-zone-card>strong{display:block;font-size:1.3rem}.exp254-zone-card>small{display:block;margin-top:.25rem;margin-bottom:1rem;color:#e4c7d8}
.exp254-placeholder-zone{display:grid;align-content:end;background:linear-gradient(145deg,#5a174e,#1b082a)}.exp254-placeholder-art{display:grid;place-items:center;height:250px;font-size:5rem;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 55%)}
.exp254-result-card{display:flex;gap:1rem;align-items:center;margin-top:1rem;padding:1.2rem;border:1px solid rgba(255,151,207,.45);border-radius:20px;background:#0c000f}.exp254-result-card>span{font-size:2.5rem}.exp254-result-card h3{margin:.15rem 0;font-size:1.45rem}
.exp254-secret-card{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-top:1rem;padding:1.25rem;border:1px dashed #ffd66a;border-radius:20px;background:linear-gradient(135deg,#2c102b,#0b000d)}.exp254-secret-card button{width:72px;height:72px;border:2px solid #ffd66a;border-radius:50%;background:#1c0618;color:#ffd66a;font-size:2rem;font-weight:900;cursor:pointer}.exp254-secret-card.is-found button{background:linear-gradient(135deg,#ff3ca8,#8e2dff);color:#fff;box-shadow:0 0 28px rgba(255,71,174,.45)}
.exp254-future-board{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1rem;padding:1rem;border-radius:18px;background:#ffffff08}.exp254-future-board small{width:100%;color:#ffacd5}.exp254-future-board span{padding:.55rem .75rem;border:1px solid #ffffff1f;border-radius:999px}
@media(max-width:760px){.exp254-music-bar{align-items:flex-start;flex-direction:column}.exp254-zone-grid{grid-template-columns:1fr}.exp254-zone-card{min-height:0}.exp254-secret-card{align-items:flex-start}.exp254-future-board{display:grid}}
